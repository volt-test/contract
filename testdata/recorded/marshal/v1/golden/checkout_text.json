{"name":"golden checkout","virtual_users":20,"duration":"10s","ramp_up":"2s","http_timeout":"10s","target":{"url":"http://localhost:8085","idle_timeout":"30s"},"scenarios":[{"name":"Shopper","weight":70,"auto_handle_cookies":false,"steps":[{"name":"Login","request":{"method":"POST","url":"http://localhost:8085/api/login","body":"{\"email\":\"user@example.com\",\"password\":\"example-password\"}","header":{"Content-Type":"application/json"}},"extract":[{"variable_name":"token","selector":"$.data.token","type":"json"}],"validate":[{"name":"logged in","type":"status_code","expected":200}]},{"name":"List products","request":{"method":"GET","url":"http://localhost:8085/api/products?page=1","header":{}},"extract":[{"variable_name":"product_id","selector":"$.data[0].id","type":"json"}],"validate":[{"name":"listed","type":"status_code","expected":200}]},{"name":"Add to cart","request":{"method":"POST","url":"http://localhost:8085/api/cart","body":"{\"product_id\": ${product_id}, \"quantity\": 1}","header":{"Authorization":"Bearer ${token}","Content-Type":"application/json"}},"extract":[{"variable_name":"cart_id","selector":"$.data.cart_id","type":"json"}],"validate":[{"name":"cart","type":"status_code","expected":201}]},{"name":"Checkout","request":{"method":"POST","url":"http://localhost:8085/api/checkout","body":"{\"cart_id\": \"${cart_id}\"}","header":{"Authorization":"Bearer ${token}","Content-Type":"application/json"}},"validate":[{"name":"order","type":"status_code","expected":200}]}],"data_config":{}},{"name":"Browser","weight":30,"think_time":"500ms","auto_handle_cookies":false,"steps":[{"name":"Products","request":{"method":"GET","url":"http://localhost:8085/api/products?page=2","header":{}},"validate":[{"name":"listed","type":"status_code","expected":200}]}],"data_config":{}}],"weights":[70,30]}
