{"schema_version":"2.0","name":"Setup and teardown","virtual_users":2,"duration":"30s","scenarios":[{"name":"Log in","steps":[{"name":"Login","request":{"method":"POST","url":"https://shop.example.com/api/login","body":"{\"email\":\"admin@example.com\",\"password\":\"example-password\"}","headers":{"Content-Type":"application/json"}},"extract":[{"variable_name":"admin_token","selector":"$.data.token","type":"json","required":true}]}],"run_once":true},{"name":"Seed","steps":[{"name":"Seed product","request":{"method":"POST","url":"https://shop.example.com/api/products","body":"{\"name\":\"Load test product\"}","headers":{"Authorization":"Bearer ${admin_token}","Content-Type":"application/json"}},"extract":[{"variable_name":"product_id","selector":"$.data.id","type":"json","required":true}]}],"run_once":true},{"name":"Browse","weight":3,"steps":[{"name":"Get product","request":{"method":"GET","url":"https://shop.example.com/api/products/${product_id}","headers":{"Authorization":"Bearer ${admin_token}"}},"extract":[{"variable_name":"price","selector":"$.data.price","type":"json"}]}]},{"name":"Browse again","steps":[{"name":"Get product","request":{"method":"GET","url":"https://shop.example.com/api/products/${product_id}","headers":{"Authorization":"Bearer ${admin_token}"}},"extract":[{"variable_name":"price","selector":"$.data.price","type":"json"}]}]},{"name":"Clean up","steps":[{"name":"Delete product","request":{"method":"DELETE","url":"https://shop.example.com/api/products/${product_id}","headers":{"Authorization":"Bearer ${admin_token}"}}}],"teardown":true}]}
