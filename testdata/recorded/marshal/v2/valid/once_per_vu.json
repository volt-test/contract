{"schema_version":"2.0","name":"Once-per-VU steps","virtual_users":2,"duration":"30s","scenarios":[{"name":"Seed","steps":[{"name":"Reset catalog","request":{"method":"POST","url":"https://shop.example.com/api/reset"}}],"run_once":true},{"name":"Shop","weight":3,"steps":[{"name":"Login","request":{"method":"POST","url":"https://shop.example.com/api/login","body":"{\"email\":\"user@example.com\",\"password\":\"example-password\"}","headers":{"Content-Type":"application/json"}},"extract":[{"variable_name":"token","selector":"$.data.token","type":"json","required":true,"on_fail":"abort"}],"think_time":"1s","once_per_vu":true},{"name":"Cart","request":{"method":"GET","url":"https://shop.example.com/api/cart","headers":{"Authorization":"Bearer ${token}"}}}]},{"name":"Admin","weight":1,"steps":[{"name":"Admin login","request":{"method":"POST","url":"https://shop.example.com/api/admin/login","body":"{\"email\":\"admin@example.com\",\"password\":\"example-password\"}","headers":{"Content-Type":"application/json"}},"extract":[{"variable_name":"admin_token","selector":"$.data.token","type":"json","required":true}],"once_per_vu":true},{"name":"Orders","request":{"method":"GET","url":"https://shop.example.com/api/admin/orders","headers":{"Authorization":"Bearer ${admin_token}"}}}]}]}
