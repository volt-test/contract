{"schema_version":"2.0","name":"JSON request bodies","virtual_users":2,"duration":"30s","scenarios":[{"name":"Checkout","steps":[{"name":"Login","request":{"method":"POST","url":"https://shop.example.com/api/login","body_type":"json","body_json":{"email":"user@example.com","password":"example-password"}},"extract":[{"variable_name":"token","selector":"$.data.token","type":"json"},{"variable_name":"flag","selector":"$.data.flag","type":"json"}]},{"name":"Add to cart","request":{"method":"POST","url":"https://shop.example.com/api/cart","body_type":"json","body_json":{"sku":"SKU-1","qty":"${random_int(1,3)}","ok":"${flag}","note":"n ${uuid}","price":19.90,"big":12345678901234567890,"tags":["\u003cb\u003e","a \u0026 b",null,true],"nested":{"z":1,"a":{"empty":{},"list":[]}}},"headers":{"Authorization":"Bearer ${token}"}}},{"name":"Bulk update","request":{"method":"PUT","url":"https://shop.example.com/api/cart/items","body_type":"json","body_json":[{"id":1,"qty":2},{"id":2,"qty":"${counter}"}],"headers":{"Authorization":"Bearer ${token}","content-type":"application/vnd.shop+json"}}},{"name":"Raw note","request":{"method":"POST","url":"https://shop.example.com/api/notes","body":"note ${uuid}","body_type":"raw","headers":{"Content-Type":"text/plain"}}},{"name":"Empty object","request":{"method":"POST","url":"https://shop.example.com/api/ping","body_type":"json","body_json":{}}}]}]}
