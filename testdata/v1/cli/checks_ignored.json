{
  "name": "v1 definition with checks keys",
  "virtual_users": 2,
  "duration": "10s",
  "target": {
    "url": "https://api.example.com",
    "idle_timeout": "30s"
  },
  "expected_statuses": [200, 600],
  "scenarios": [
    {
      "name": "Read",
      "weight": 1,
      "steps": [
        {
          "name": "Items",
          "request": {
            "method": "GET",
            "url": "https://api.example.com/items"
          },
          "extract": [
            {
              "variable_name": "first_id",
              "selector": "$.data[0].id",
              "type": "json",
              "required": true,
              "on_fail": "abort",
              "pick": "all"
            },
            {
              "variable_name": "cursor",
              "selector": "$.meta.cursor",
              "type": "json",
              "required": false,
              "on_fail": "explode",
              "pick": "explode"
            },
            {
              "variable_name": "etag",
              "selector": "ETag",
              "type": "header",
              "pick": "first"
            }
          ],
          "checks": [
            {
              "type": "status",
              "in": [200]
            },
            {
              "type": "json",
              "selector": "$.data[0].id",
              "equals": 42,
              "exists": false,
              "on_fail": "explode"
            },
            {
              "type": "status",
              "between": [500]
            }
          ],
          "validate": [
            {
              "name": "status",
              "type": "status",
              "expected": 200
            }
          ]
        },
        {
          "name": "Item",
          "request": {
            "method": "GET",
            "url": "https://api.example.com/items/${first_id}"
          },
          "checks": [
            {
              "type": "status",
              "in": [99]
            }
          ]
        }
      ]
    }
  ]
}
