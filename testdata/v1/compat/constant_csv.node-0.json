{
  "name": "v1 compat: constant csv",
  "description": "v1 compatibility fixture",
  "virtual_users": 10,
  "duration": "20s",
  "ramp_up": "2s",
  "target": {
    "url": "http://demo-target:8080"
  },
  "scenarios": [
    {
      "name": "Shopper",
      "weight": 100,
      "steps": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "url": "http://demo-target:8080/api/login",
            "headers": {
              "Content-Type": "application/json"
            },
            "body": "{\"email\":\"${email}\",\"password\":\"${password}\"}"
          },
          "extract": [
            {
              "variable_name": "token",
              "selector": "$.data.token",
              "type": "json"
            }
          ],
          "validate": [
            {
              "name": "logged in",
              "type": "status_code",
              "expected": 200
            }
          ]
        },
        {
          "name": "List products",
          "request": {
            "method": "GET",
            "url": "http://demo-target:8080/api/products?page=1",
            "headers": {
              "Authorization": "Bearer ${token}"
            }
          },
          "extract": [
            {
              "variable_name": "product_id",
              "selector": "$.data[0].id",
              "type": "json"
            }
          ],
          "validate": [
            {
              "name": "listed",
              "type": "status_code",
              "expected": 200
            }
          ]
        },
        {
          "name": "View product",
          "request": {
            "method": "GET",
            "url": "http://demo-target:8080/api/products/${product_id}"
          },
          "validate": [
            {
              "name": "found",
              "type": "status_code",
              "expected": 200
            }
          ]
        }
      ],
      "data_config": {
        "data_source": "users.csv",
        "data_download_url": "https://storage.example.com/data-sources/example.csv",
        "data_format": "csv",
        "has_header": true,
        "mode": "sequential"
      }
    }
  ]
}
