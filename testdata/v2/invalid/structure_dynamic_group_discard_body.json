{
  "schema_version": "2.0",
  "name": "discard_body with a body check inside a group",
  "virtual_users": 1,
  "scenarios": [
    {
      "name": "Shop",
      "steps": [
        {
          "name": "Loop",
          "repeat": {
            "until": "done",
            "max": 5
          },
          "steps": [
            {
              "name": "Inner",
              "request": {
                "method": "GET",
                "url": "https://shop.example.com/inner"
              },
              "discard_body": true,
              "checks": [
                {
                  "type": "body",
                  "contains": "ok"
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
