{
  "schema_version": "2.0",
  "name": "Multipart with a Content-Type header",
  "virtual_users": 1,
  "duration": "10s",
  "scenarios": [
    {
      "name": "Shop",
      "steps": [
        {
          "name": "Send",
          "request": {
            "method": "POST",
