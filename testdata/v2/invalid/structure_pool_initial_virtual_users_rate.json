{
  "schema_version": "2.0",
  "name": "Invalid scenario load",
  "virtual_users": 1,
  "duration": "30s",
  "scenarios": [
    {
      "name": "Home",
      "steps": [
        {
          "name": "Get home",
          "request": {
            "method": "GET",
            "url": "https://shop.example.com/"
          }
        }
      ]
    },
    {
      "name": "Pool",
      "load": {
        "type": "rate",
        "rate": 5,
        "duration": "1m",
