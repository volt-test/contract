{
  "schema_version": "2.0",
  "name": "Binary step with a json check",
  "virtual_users": 1,
  "duration": "10s",
  "scenarios": [
    {
      "name": "Shop",
      "steps": [
        {
          "name": "Send",
          "request": {
            "method": "GET",
            "url": "https://shop.example.com/api"
          },
          "response_type": "binary",
          "checks": [
            {
              "type": "json",
              "selector": "$.id",
              "exists": true
            }
          ]
        }
      ]
    }
  ]
}
