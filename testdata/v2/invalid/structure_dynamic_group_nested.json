{
  "schema_version": "2.0",
  "name": "Nested group",
  "virtual_users": 1,
  "scenarios": [
    {
      "name": "Shop",
      "steps": [
        {
          "name": "Outer",
          "repeat": {
            "until": "done",
            "max": 5
          },
          "steps": [
            {
              "name": "Inner",
              "repeat": {
                "until": "done",
                "max": 5
              },
              "steps": [
                {
                  "name": "Deep",
                  "request": {
                    "method": "GET",
                    "url": "https://shop.example.com/deep"
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
