{
  "schema_version": "2.0",
  "name": "discard_body with a regex extractor",
  "virtual_users": 1,
  "duration": "10s",
  "scenarios": [
    {
      "name": "Shop",
      "steps": [
        {
          "name": "Send",
          "request": {
            "method": "GET",
            "url": "https://shop.example.com/api"
          },
          "discard_body": true,
          "extract": [
            {
              "variable_name": "id",
              "selector": "id=(\\d+)",
              "type": "regex"
            }
          ]
        }
      ]
    }
  ]
}
