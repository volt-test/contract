{
  "schema_version": "2.0",
  "name": "discard_body with a body check",
  "virtual_users": 1,
  "duration": "10s",
  "scenarios": [
    {
      "name": "Shop",
      "steps": [
        {
          "name": "Send",
          "request": {
            "method": "GET",
            "url": "https://shop.example.com/api"
          },
          "discard_body": true,
          "checks": [
            {
              "type": "status",
              "in": [
                200
              ]
            },
            {
              "type": "body",
              "contains": "ok"
            }
          ]
        }
      ]
    }
  ]
}
