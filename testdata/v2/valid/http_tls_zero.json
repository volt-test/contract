{
  "schema_version": "2.0",
  "name": "HTTP and TLS zero values",
  "virtual_users": 1,
  "duration": "30s",
  "http": {
    "max_redirects": 0,
    "version": ""
  },
  "tls": {
    "insecure_skip_verify": false,
    "min_version": "",
    "client_cert": "",
    "client_key": "",
    "ca_cert": ""
  },
  "scenarios": [
    {
      "name": "Home",
      "steps": [
        {
          "name": "Get home",
          "request": {
            "method": "GET",
            "url": "https://shop.example.com/"
          },
          "follow_redirects": false,
          "max_redirects": 0
        },
        {
          "name": "Zero max_redirects",
          "request": {
            "method": "GET",
            "url": "https://shop.example.com/a"
          },
          "max_redirects": 0
        }
      ]
    }
  ]
}
