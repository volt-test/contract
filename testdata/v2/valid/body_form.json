{
  "schema_version": "2.0",
  "name": "Form request bodies",
  "virtual_users": 2,
  "duration": "30s",
  "scenarios": [
    {
      "name": "Search",
      "steps": [
        {
          "name": "Search",
          "request": {
            "method": "POST",
            "url": "https://shop.example.com/search",
            "body_type": "form",
            "fields": {
              "q": "a b&c=d",
              "page": "${random_int(1,3)}",
              "a b": "x",
              "ü": "ü ${uuid}",
              "comment": "${fake.paragraph}",
              "empty": ""
            }
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "url": "https://shop.example.com/login",
            "headers": {
              "CONTENT-TYPE": "application/x-www-form-urlencoded; charset=utf-8"
            },
            "body_type": "form",
            "fields": {
              "zeta": "user@example.com",
              "alpha": "example-password"
            },
            "body": ""
          }
        }
      ]
    }
  ]
}
