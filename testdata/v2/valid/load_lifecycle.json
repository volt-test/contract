{
  "schema_version": "2.0",
  "name": "Ramp start and graceful stop",
  "stages": [
    {"duration": "1m", "target": 20},
    {"duration": "30s", "target": 5}
  ],
  "initial_virtual_users": 0,
  "stop_grace": "0s",
  "ramp_down_grace": "45s",
  "thresholds": ["interrupted_iterations == 0"],
  "scenarios": [
    {
      "name": "Browse",
      "thresholds": ["interrupted_iterations == 0"],
      "steps": [
        {"name": "Home", "request": {"method": "GET", "url": "https://shop.example.com/"}}
      ]
    },
    {
      "name": "Spike",
      "start_at": "30s",
      "load": {
        "type": "stages",
        "initial_virtual_users": 10,
        "stages": [{"duration": "1m", "target": 0}],
        "ramp_down_grace": "10s",
        "stop_grace": "5s"
      },
      "steps": [
        {"name": "Product", "request": {"method": "GET", "url": "https://shop.example.com/products/1"}}
      ]
    },
    {
      "name": "API",
      "load": {
        "type": "rate",
        "rate": 5,
        "duration": "2m",
        "preallocated_virtual_users": 2,
        "max_virtual_users": 10,
        "stop_grace": "1m"
      },
      "steps": [
        {"name": "Stock", "request": {"method": "GET", "url": "https://shop.example.com/api/stock"}}
      ]
    }
  ]
}
