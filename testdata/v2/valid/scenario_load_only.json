{
  "schema_version": "2.0",
  "name": "Every load scenario has its own load",
  "scenarios": [
    {
      "name": "Log in",
      "run_once": true,
      "steps": [
        {"name": "Login", "request": {"method": "POST", "url": "https://shop.example.com/api/login",
          "headers": {"Content-Type": "application/json"}, "body": "{\"email\":\"admin@example.com\"}"},
          "extract": [{"variable_name": "admin_token", "selector": "$.data.token", "type": "json"}]}
      ]
    },
    {
      "name": "Browse",
      "load": {"type": "constant", "virtual_users": 1, "duration": "1m"},
      "steps": [
        {"name": "Home", "request": {"method": "GET", "url": "https://shop.example.com/"}}
      ]
    },
    {
      "name": "Buy",
      "start_at": "10s",
      "load": {
        "type": "stages",
        "stages": [{"duration": "20s", "target": 0}, {"duration": "20s", "target": 1}]
      },
      "steps": [
        {"name": "Cart", "request": {"method": "GET", "url": "https://shop.example.com/cart",
          "headers": {"Authorization": "Bearer ${admin_token}"}}}
      ]
    }
  ]
}
