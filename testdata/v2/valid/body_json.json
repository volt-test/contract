{
  "schema_version": "2.0",
  "name": "JSON request bodies",
  "virtual_users": 2,
  "duration": "30s",
  "scenarios": [
    {
      "name": "Checkout",
      "steps": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "url": "https://shop.example.com/api/login",
            "body_type": "json",
            "body_json": {"email": "user@example.com", "password": "example-password"}
          },
          "extract": [
            {"variable_name": "token", "selector": "$.data.token", "type": "json"},
            {"variable_name": "flag", "selector": "$.data.flag", "type": "json"}
          ]
        },
        {
          "name": "Add to cart",
          "request": {
            "method": "POST",
            "url": "https://shop.example.com/api/cart",
            "headers": {
              "Authorization": "Bearer ${token}"
            },
            "body_type": "json",
            "body_json": {
              "sku": "SKU-1",
              "qty": "${random_int(1,3)}",
              "ok": "${flag}",
              "note": "n ${uuid}",
              "price": 19.90,
              "big": 12345678901234567890,
              "tags": ["<b>", "a & b", null, true],
              "nested": {"z": 1, "a": {"empty": {}, "list": []}}
            }
          }
        },
        {
          "name": "Bulk update",
          "request": {
            "method": "PUT",
            "url": "https://shop.example.com/api/cart/items",
            "headers": {
              "Authorization": "Bearer ${token}",
              "content-type": "application/vnd.shop+json"
            },
            "body_type": "json",
            "body_json": [{"id": 1, "qty": 2}, {"id": 2, "qty": "${counter}"}]
          }
        },
        {
          "name": "Raw note",
          "request": {
            "method": "POST",
            "url": "https://shop.example.com/api/notes",
            "headers": {
              "Content-Type": "text/plain"
            },
            "body_type": "raw",
            "body": "note ${uuid}"
          }
        },
        {
          "name": "Empty object",
          "request": {
            "method": "POST",
            "url": "https://shop.example.com/api/ping",
            "body_type": "json",
            "body_json": {}
          }
        }
      ]
    }
  ]
}
