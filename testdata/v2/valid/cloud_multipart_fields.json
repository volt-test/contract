{
  "schema_version": "2.0",
  "name": "Multipart fields only, allowed on VoltTest Cloud",
  "virtual_users": 1,
  "duration": "30s",
  "scenarios": [
    {
      "name": "Upload",
      "steps": [
        {
          "name": "Send",
          "request": {
            "method": "POST",
            "url": "https://shop.example.com/api/upload",
            "body_type": "multipart",
            "fields": {"title": "Report", "note": "${uuid}"}
          }
        }
      ]
    }
  ]
}
